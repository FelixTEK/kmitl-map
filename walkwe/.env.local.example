# ก็อปไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง

# ใช้สำหรับ /api/route (คำนวณเส้นทางเดินจาก OpenRouteService)
# สมัครฟรีได้ที่ https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ใช้สำหรับ /api/chat (แชทบอทผู้ช่วยเดิน - Typhoon LLM)
# สมัครที่ https://opentyphoon.ai
TYPHOON_API_KEY=

# ใช้สำหรับ /api/report และ /api/locations (เชื่อมต่อ PostgreSQL)
# รูปแบบ: postgres://<user>:<password>@<host>:5432/<db_name>
DATABASE_URL=
